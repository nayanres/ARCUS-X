# ARCUS-X reference evaluation environment (runtime / API-only).
#
# This image is the CANONICAL, archival artifact used to generate the paper's
# results. The Dockerfile is provided as a convenience for rebuilding; it is
# NOT guaranteed to produce a bit-identical image forever (base-image digests
# and package registries can change over time). Reviewers should pull the
# published, digest-pinned image rather than rebuild from scratch.
#
# Pin the base image by DIGEST to freeze the OS snapshot (glibc, openssl, ...).
# Get the current digest with:
#     docker pull python:3.11-slim
#     docker inspect --format='{{index .RepoDigests 0}}' python:3.11-slim
# then replace the FROM line below with e.g.
#     FROM python:3.11-slim@sha256:<digest>
FROM python:3.11-slim

# Build dependencies for any source wheels in the lock. We do NOT pin each apt
# package version: pinning the base image by digest already freezes the OS
# snapshot, and reviewers pull the built image (they never run apt).
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps from the PINNED lock (not the flexible requirements.txt).
# This is the layer that must stay version-exact for reproducibility.
COPY requirements-lock.txt /tmp/requirements-lock.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements-lock.txt \
    && rm -f /tmp/requirements-lock.txt

# Application code.
COPY . /app
WORKDIR /app
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Run as a non-root user.
RUN useradd --create-home --uid 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

# Default: prove the environment works. Override to run benchmarks, e.g.
#   docker run ... ghcr.io/<org>/arcus-x:iclr2025 \
#       python -m arcus.experiments.quickstart --api-key "$KEY" --n-probes 5
CMD ["python", "tests/test_arcus_hardening.py"]
