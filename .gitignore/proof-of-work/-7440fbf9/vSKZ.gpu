# ARCUS-X optional LOCAL-INFERENCE image (torch / vLLM / transformers, GPU).
#
# This is a SECONDARY, optional image. The primary reference environment for
# the paper is the runtime/API-only image (Dockerfile). Build this only if you
# run models locally on a CUDA-capable GPU.
#
# Pin the CUDA base by digest (same procedure as the runtime image):
#     docker pull nvidia/cuda:12.1.1-runtime-ubuntu22.04
#     docker inspect --format='{{index .RepoDigests 0}}' nvidia/cuda:12.1.1-runtime-ubuntu22.04
# then use e.g.  FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04@sha256:<digest>
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3-pip gcc g++ \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3

COPY requirements-lock-local.txt /tmp/requirements-lock-local.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements-lock-local.txt \
    && rm -f /tmp/requirements-lock-local.txt

COPY . /app
WORKDIR /app
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

CMD ["python", "tests/test_arcus_hardening.py"]
